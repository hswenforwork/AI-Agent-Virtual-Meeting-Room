# 前端可公開（這些值本來就會被瀏覽器看到，安全性靠 Supabase RLS，不是靠藏住它們）
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_BASE_PATH=/

# 以下只在 Supabase Edge Function 的 secrets 設定，絕對不要放進這個檔案的實際值、
# 也絕對不要 commit 到 GitHub。用 `supabase secrets set` 或 Supabase Dashboard 設定。
# GEMINI_API_KEY / OPENAI_API_KEY 之後啟用 GPT／Gemini 時才需要。
# ANTHROPIC_API_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# ALLOWED_ORIGINS=
# DEFAULT_CLAUDE_MODEL=claude-sonnet-5
# MAX_AGENT_RUNS_PER_MESSAGE=4
